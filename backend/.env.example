# ── Application ──────────────────────────────────────────────────────────────
# TCP port the backend listens on.
APP_PORT=3000
# Runtime environment: development | staging | production
APP_ENV=development
# Tracing/log level (RUST_LOG syntax: info, debug, warn, error, off)
RUST_LOG=info

# ── Base de données ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://myhouse:myhouse@postgres:5432/myhouse

# ── JWT ───────────────────────────────────────────────────────────────────────
# Minimum 32 bytes (256 bits). Generate with: openssl rand -hex 32
JWT_SECRET=<minimum_256_bits_random_string>
# Access-token lifetime in seconds (900 = 15 minutes)
JWT_ACCESS_TTL_SECONDS=900
# Refresh-token sliding TTL in days
JWT_REFRESH_TTL_DAYS=30

# ── OTP ───────────────────────────────────────────────────────────────────────
# OTP code lifetime in seconds (600 = 10 minutes)
OTP_TTL_SECONDS=600
# Maximum verification attempts before the OTP is invalidated
OTP_MAX_ATTEMPTS=3
# Minimum gap between two OTP requests for the same email (in seconds)
OTP_RATE_LIMIT_SECONDS=60

# ── Storage ───────────────────────────────────────────────────────────────────
# Storage backend: local (MVP) | s3 (V2 — not yet implemented)
STORAGE_PROVIDER=local
# Root directory for LocalFsStorage (Docker volume storage_data is mounted here)
LOCAL_STORAGE_PATH=/app/storage
# Base URL prepended to storage keys for public media (listings, avatars)
PUBLIC_MEDIA_BASE_URL=http://localhost/media

# ── AWS S3 — reserved V2, unused when STORAGE_PROVIDER=local ─────────────────
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_BUCKET=myhouse

# ── Cookies ───────────────────────────────────────────────────────────────────
# Domain attribute of the refresh_token cookie (HttpOnly, Secure, SameSite=Strict)
COOKIE_DOMAIN=localhost

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API (no trailing slash).
ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@myhouse.app
ADMIN_NOTIFICATION_EMAIL=admin@myhouse.app

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Generic per-IP request cap, defense-in-depth (distinct from OTP_RATE_LIMIT_SECONDS).
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
# Reverse proxies whose X-Forwarded-For is trusted (comma-separated IPs/CIDRs).
# Empty = no proxy trusted, the peer IP is used (correct for a bare `cargo run`).
# In staging/prod set the narrowest range that covers nginx only. Do NOT use a
# broad range like 172.16.0.0/12 while backend-prod still publishes port 3000 to
# the host: docker may present a direct connection as coming from the bridge
# gateway, which such a range would wrongly trust, re-opening XFF spoofing.
TRUSTED_PROXIES=
