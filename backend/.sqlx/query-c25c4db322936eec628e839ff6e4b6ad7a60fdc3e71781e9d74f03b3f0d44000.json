  "query": "\n        SELECT id, status AS \"status: OwnerRequestStatus\",\n               to_char(created_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"') AS \"created_at!\"\n        FROM owner_requests\n        WHERE user_id = $1\n        ORDER BY created_at DESC\n        LIMIT 1\n        ",
