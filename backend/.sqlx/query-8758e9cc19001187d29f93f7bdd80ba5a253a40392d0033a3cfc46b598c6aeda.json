{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            rt.id,\n            rt.user_id,\n            u.role AS \"role: Role\",\n            (rt.revoked_at IS NOT NULL) AS \"is_revoked!\",\n            (rt.expires_at < NOW())     AS \"is_expired!\"\n        FROM refresh_tokens rt\n        JOIN users u ON u.id = rt.user_id\n        WHERE rt.token_hash = $1\n        LIMIT 1\n        ",
