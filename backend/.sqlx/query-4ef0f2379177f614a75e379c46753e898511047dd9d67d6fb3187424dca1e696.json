{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            u.id,\n            u.email,\n            u.first_name,\n            u.last_name,\n            u.phone,\n            u.role AS \"role: Role\",\n            u.is_active,\n            to_char(u.created_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"') AS \"created_at!\",\n            (SELECT COUNT(*) FROM listings l WHERE l.owner_id = u.id) AS \"listing_count!\"\n        FROM users u\n        WHERE u.id = $1\n        ",
