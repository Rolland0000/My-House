  "query": "\n        SELECT m.listing_id, l.owner_id, m.storage_key, m.is_cover\n        FROM listing_media m\n        JOIN listings l ON l.id = m.listing_id\n        WHERE m.id = $1\n        FOR UPDATE OF l, m\n        ",
