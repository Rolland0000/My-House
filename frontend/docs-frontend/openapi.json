{
  "openapi": "3.1.0",
  "info": {
    "title": "MyHouse API",
    "description": "Real estate rental matching platform (owners ↔ seekers).",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/admin/owner-requests": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Admin-only queue of owner requests. Delegates entirely to\n`owner_requests::service` — this module never opens its own access to the\n`owner_requests` table.",
        "operationId": "list_owner_requests",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated owner-request queue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedResponse_AdminOwnerRequestDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid `status` filter value"
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "403": {
            "description": "Caller is not an admin"
          }
        }
      }
    },
    "/api/v1/admin/owner-requests/{id}": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "One request's full detail, including `identity_data` and every document\ndescriptor — the only admin-facing route allowed to return them.",
        "operationId": "get_owner_request",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Owner request id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full request detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOwnerRequestDetailResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "403": {
            "description": "Caller is not an admin"
          },
          "404": {
            "description": "No request with this id"
          }
        }
      },
      "patch": {
        "tags": [
          "admin"
        ],
        "summary": "Records an admin's approve/reject decision. Delegates the whole\ntransaction (status write, role promotion on approval, notification) to\n`owner_requests::service::review` — this handler only authorizes and logs.",
        "operationId": "review_owner_request",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Owner request id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewOwnerRequestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Updated request detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOwnerRequestDetailResponse"
                }
              }
            }
          },
          "400": {
            "description": "`status` is neither `approved` nor `rejected`"
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "403": {
            "description": "Caller is not an admin"
          },
          "404": {
            "description": "No request with this id"
          },
          "409": {
            "description": "Request is no longer pending"
          }
        }
      }
    },
    "/api/v1/admin/owner-requests/{id}/documents/{doc_id}": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Streams one identity document's raw bytes back to an admin — the sole\nbackend endpoint that proxies storage reads instead of leaving a file to\nbe served statically (`ARCHITECTURE.md` §7.3). `content_type` comes from\nthe upload-time magic-byte check, not from client input, so it's safe to\necho straight into the response header.",
        "operationId": "get_owner_request_document",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Owner request id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "doc_id",
            "in": "path",
            "description": "Document id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Raw document bytes",
            "content": {
              "application/octet-stream": {}
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "403": {
            "description": "Caller is not an admin"
          },
          "404": {
            "description": "No such request or document"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "The access token itself keeps authenticating requests until its own\n(max 15 min) expiry — MH-35's stateless JWTs can't be invalidated early.\nLogout only guarantees the session can't be *refreshed* again.",
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Current refresh token revoked; cookie cleared"
          },
          "401": {
            "description": "Missing or invalid access token"
          }
        }
      }
    },
    "/api/v1/auth/otp/request": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Identical 200 response whether `payload.email` is registered or not —\nthe endpoint must never let a caller enumerate accounts.",
        "operationId": "otp_request",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OTP code generated and emailed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpRequestResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests for this email within the rate-limit window"
          }
        }
      }
    },
    "/api/v1/auth/otp/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Second half of the unified auth endpoint (seeker_auth_flow.mermaid §2):\nverifies the code cached by `/auth/otp/request`. A known email gets its\nsession straight away; an unknown one gets a single-use registration\nticket — no account row and no cookie until `/auth/register` runs.",
        "operationId": "otp_verify",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerifyDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OTP verified; session issued, or registration ticket returned for an unknown email",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpVerifyResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, or attempt-exhausted OTP code"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "refresh",
        "responses": {
          "200": {
            "description": "New access token issued; refresh cookie rotated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, expired, or reused refresh token"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Creates the account in one transaction from the ticket handed out by\n`/auth/otp/verify`, and opens the session.",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Account created; session issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing or over-long last_name / phone"
          },
          "401": {
            "description": "Unknown, expired, or already-used registration ticket"
          },
          "409": {
            "description": "An account already exists for this email"
          }
        }
      }
    },
    "/api/v1/listings": {
      "get": {
        "tags": [
          "listings"
        ],
        "summary": "Public paginated feed of listings (cover photo + summary).",
        "operationId": "list",
        "parameters": [
          {
            "name": "owner_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ListingType"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of listings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedResponse_ListingSummaryDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/listings/{id}": {
      "get": {
        "tags": [
          "listings"
        ],
        "summary": "Full listing detail — description, media, owner info (no phone).",
        "operationId": "get_by_id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Listing id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Listing detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListingDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Listing not found"
          }
        }
      }
    },
    "/api/v1/owner-requests": {
      "post": {
        "tags": [
          "owner_requests"
        ],
        "operationId": "submit_owner_request",
        "requestBody": {
          "description": "phone, optional secondary_phone, identity_data (JSON string), and either two image documents (front, back) or one PDF",
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/OwnerRequestSubmissionForm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Request created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OwnerRequestResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed multipart body or identity_data"
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "403": {
            "description": "Caller is an admin"
          },
          "409": {
            "description": "A pending request already exists for this user"
          },
          "413": {
            "description": "A document exceeds its maximum allowed size"
          },
          "422": {
            "description": "Wrong number or combination of documents, or an unsupported format"
          }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "tags": [
          "users"
        ],
        "operationId": "get_me",
        "responses": {
          "200": {
            "description": "Caller profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "put": {
        "tags": [
          "users"
        ],
        "operationId": "update_me",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMeDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Profile updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing or oversized first_name, last_name or phone"
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "delete": {
        "tags": [
          "users"
        ],
        "summary": "Deletes the caller's own account only — `user_id` comes from the access\ntoken, never from a path or body parameter. The refresh cookie is cleared\nunconditionally: the account row (and its refresh tokens, via cascade) is\nalready gone by the time this runs.",
        "operationId": "delete_me",
        "responses": {
          "200": {
            "description": "Account deleted; session cookie cleared"
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/v1/users/me/avatar": {
      "post": {
        "tags": [
          "users"
        ],
        "operationId": "upload_avatar",
        "requestBody": {
          "description": "Image (JPEG, PNG or WebP, 5 MB max) in a `file` field",
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/AvatarUploadForm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Avatar replaced",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed multipart body or missing `file` field"
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "404": {
            "description": "User not found"
          },
          "413": {
            "description": "File exceeds the maximum allowed size"
          },
          "422": {
            "description": "Unsupported image format"
          }
        }
      }
    },
    "/api/v1/users/me/owner-request": {
      "get": {
        "tags": [
          "owner_requests"
        ],
        "operationId": "get_owner_request_status",
        "responses": {
          "200": {
            "description": "Caller's current or most recent request, or `data: null` if none exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OwnerRequestStatusResponse"
                },
                "examples": {
                  "Empty": {
                    "summary": "No request on file",
                    "value": {
                      "data": null
                    }
                  },
                  "Populated": {
                    "summary": "A request exists",
                    "value": {
                      "data": {
                        "admin_note": null,
                        "created_at": "2026-09-01T10:00:00Z",
                        "id": "5b1f7e2a-3c4d-4e5f-8a9b-0c1d2e3f4a5b",
                        "reviewed_at": null,
                        "status": "pending"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Checks PostgreSQL connectivity via `SELECT 1`.",
        "operationId": "check",
        "responses": {
          "200": {
            "description": "Database reachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/health/storage": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Throwaway smoke check confirming `Arc<dyn StorageProvider>` (MH-27) is reachable\nfrom a handler via `State<AppState>` extraction. No module has real uploads yet\n(first real caller is EP-08/Media) — this only proves the plumbing compiles and\nresolves through the extractor, mirroring [`check`] above.",
        "operationId": "check_storage",
        "responses": {
          "200": {
            "description": "Storage provider reachable via AppState",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminOwnerRequestDetailDto": {
        "type": "object",
        "description": "One request's full detail, including `identity_data` and every document\ndescriptor — only ever fetched one id at a time, never listed.",
        "required": [
          "id",
          "email",
          "full_name",
          "phone",
          "identity_data",
          "status",
          "created_at",
          "documents"
        ],
        "properties": {
          "admin_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminOwnerRequestDocumentDto"
            }
          },
          "email": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "identity_data": {
            "$ref": "#/components/schemas/ValidatedIdentityData"
          },
          "phone": {
            "type": "string"
          },
          "reviewed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "secondary_phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/OwnerRequestStatus"
          }
        }
      },
      "AdminOwnerRequestDetailResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AdminOwnerRequestDetailDto"
          }
        }
      },
      "AdminOwnerRequestDocumentDto": {
        "type": "object",
        "description": "One document descriptor in the admin queue — never carries `storage_key`.",
        "required": [
          "doc_id",
          "original_filename",
          "content_type"
        ],
        "properties": {
          "content_type": {
            "type": "string"
          },
          "doc_id": {
            "type": "string",
            "format": "uuid"
          },
          "original_filename": {
            "type": "string"
          },
          "side": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AdminOwnerRequestDto": {
        "type": "object",
        "description": "One row of the admin owner-request queue. Carries only what triage needs\nat a glance — no `identity_data`, no documents; those live behind\n[`AdminOwnerRequestDetailDto`].",
        "required": [
          "id",
          "email",
          "full_name",
          "phone",
          "status",
          "created_at"
        ],
        "properties": {
          "admin_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "phone": {
            "type": "string"
          },
          "reviewed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "secondary_phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/OwnerRequestStatus"
          }
        }
      },
      "AvatarUploadForm": {
        "type": "object",
        "description": "Documents the avatar upload body for the OpenAPI schema. Nothing\ndeserializes into it — the handler walks the multipart fields itself.",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary"
          }
        }
      },
      "HealthStatus": {
        "type": "object",
        "description": "Health check response body.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "ListingDetailDto": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "type",
          "status",
          "city",
          "price",
          "media",
          "owner",
          "created_at"
        ],
        "properties": {
          "city": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ListingMediaDto"
            }
          },
          "neighborhood": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "$ref": "#/components/schemas/OwnerDetailDto"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "rooms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "status": {
            "$ref": "#/components/schemas/ListingStatus"
          },
          "surface_m2": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ListingType"
          }
        }
      },
      "ListingDetailResponse": {
        "type": "object",
