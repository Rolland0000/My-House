# ── OpenAPI codegen ────────────────────────────────────────────────────────────
# Host and port of the backend whose live /api/docs/openapi.json is fetched by
# `npm run generate:types` (invoked automatically by the `predev` hook before
# `npm run dev`). Not used by Vite itself — only by this npm script.
#
# Bare `npm run dev` on the host (backend running via `cargo run` on localhost):
#   API_HOST=localhost
#   APP_PORT=3000
#
# Inside docker-compose (dev profile) the backend is only reachable at its
# service name, not localhost — see docker-compose.yml's frontend-dev service,
# which sets these automatically:
#   API_HOST=backend-dev
#   APP_PORT=3000
API_HOST=localhost
APP_PORT=3000
