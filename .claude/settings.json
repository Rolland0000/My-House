{
  "permissions": {
    "allow": [
      "Bash(SQLX_OFFLINE=true cargo check)",
      "Bash(cargo fmt *)",
      "mcp__context7__query-docs",
      "Bash(graphify export *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/hermann/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/hermann/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  }
}
